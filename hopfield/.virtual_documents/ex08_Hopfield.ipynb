    for count in range(n_iters):
        node_idx = list(range(N))
        np.random.shuffle(node_idx)
        for k in node_idx:
            ic = x@W[:,k] - b[k]
            x[0,k] = Thresh(ic)





for idx,t in enumerate(X):
